---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import FaqAccordion from '../components/sections/FaqAccordion.astro';
import SignageIcon from '../components/sections/SignageIcon.astro';
import ProductName from '../components/layout/ProductName.astro';
import { getDictionary } from '../content/i18n';
import { alternateLocale, pathFor, type Locale } from '../lib/i18n/routes';
import { faqSchema } from '../lib/seo/schema';
import { signageSectorEntries, signageSectorKeys, type SignageSectorKey } from '../data/signage';

interface Props {
  sectorKey: SignageSectorKey;
  locale: Locale;
}

const { sectorKey, locale } = Astro.props;
const dict = getDictionary(locale);
const sector = dict.signage.sectors[sectorKey];

const { routeId } = signageSectorEntries[sectorKey];
const path = pathFor(routeId, locale);
const signagePath = pathFor('signage', locale);

// Siblings at the foot, so the set is crawlable from any entry point rather
// than only through the product page.
const others = signageSectorKeys.filter((key) => key !== sectorKey);
---

<BaseLayout
  title={sector.title}
  description={sector.metaDescription}
  path={path}
  locale={locale}
  alternatePath={pathFor(routeId, alternateLocale(locale))}
>
  {/* No photography, matching the rest of the signage section: the product page
      is an ink band and line icons, and inventing stock imagery for four
      sectors we have no reference shots of would look exactly like what it is. */}
  <section class="bg-ink text-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
      <Breadcrumbs
        variant="dark"
        items={[
          { name: dict.nav.home, path: pathFor('home', locale) },
          { name: dict.signage.navTag, path: signagePath },
          { name: sector.title, path },
        ]}
      />

      <div class="mt-6 flex items-center gap-4">
        <span class="text-accent"><SignageIcon name={sectorKey} /></span>
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-400">{sector.title}</p>
      </div>

      <h1 class="mt-5 text-3xl font-bold sm:text-4xl">{sector.headline}</h1>
      <p class="mt-5 max-w-2xl text-lg text-neutral-300">{sector.intro}</p>

      <div class="mt-8">
        <a
          href={pathFor('contact', locale)}
          class="btn-sweep inline-block bg-accent px-6 py-3 text-sm font-semibold text-on-accent transition hover:bg-accent-hover"
        >
          {dict.common.requestSurvey}
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div data-reveal class="max-w-3xl">
      <h2 class="text-2xl font-bold text-ink">{sector.problemTitle}</h2>
      <p class="mt-4 text-neutral-700">{sector.problemBody}</p>
    </div>
  </section>

  <section class="border-y border-neutral-100 bg-neutral-50">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 data-reveal class="text-2xl font-bold text-ink sm:text-3xl">{sector.screensTitle}</h2>
      <ul data-reveal class="mt-8 grid gap-4 sm:grid-cols-2">
        {sector.screens.map((item) => (
          <li class="flex gap-3 border border-neutral-100 bg-white p-5 text-sm text-neutral-700">
            <span aria-hidden="true" class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-accent"></span>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div data-reveal class="max-w-3xl">
      <h2 class="text-2xl font-bold text-ink">{sector.integrationTitle}</h2>
      <p class="mt-4 text-neutral-700">{sector.integrationBody}</p>
    </div>
  </section>

  <section class="bg-ink text-white">
    <div data-reveal class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <div class="max-w-3xl">
        <h2 class="text-2xl font-bold sm:text-3xl">{sector.resultTitle}</h2>
        <p class="mt-4 text-neutral-300">{sector.resultBody}</p>
      </div>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href={pathFor('servicesInstallation', locale)}
          class="border border-neutral-700 px-5 py-2.5 text-sm font-medium text-white transition hover:border-neutral-400 hover:bg-neutral-900"
        >
          {dict.services.items.installation.title}
        </a>
        <a
          href={pathFor('servicesMaintenance', locale)}
          class="border border-neutral-700 px-5 py-2.5 text-sm font-medium text-white transition hover:border-neutral-400 hover:bg-neutral-900"
        >
          {dict.services.items.maintenance.title}
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h2 data-reveal class="text-2xl font-bold text-ink sm:text-3xl">{dict.signage.faqTitle}</h2>
    <div data-reveal class="mt-8 max-w-3xl">
      <FaqAccordion items={sector.faq} />
    </div>
  </section>

  <section class="border-t border-neutral-100 bg-neutral-50">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <div data-reveal class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-2xl font-bold text-ink">{dict.signage.otherSectorsTitle}</h2>
        <a href={signagePath} class="text-sm font-medium text-neutral-600 transition hover:text-ink">
          {dict.signage.backToProduct} &rarr;
        </a>
      </div>

      <div data-reveal-group class="mt-8 grid gap-6 sm:grid-cols-3">
        {others.map((key) => (
          <a
            data-reveal
            href={pathFor(signageSectorEntries[key].routeId, locale)}
            class="sig-card card-status flex flex-col p-6"
          >
            <SignageIcon name={key} />
            <h3 class="mt-4 text-base text-ink">{dict.signage.sectors[key].title}</h3>
            <p class="mt-2 flex-1 text-sm text-neutral-600">{dict.signage.sectors[key].summary}</p>
            <span class="media-card-more mt-4 text-sm font-medium">{dict.common.readMore} &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-neutral-100">
    <div data-reveal class="mx-auto max-w-6xl px-4 py-16 text-center sm:px-6">
      <h2 class="text-2xl font-bold text-ink sm:text-3xl">{dict.signage.ctaTitle}</h2>
      <p class="mx-auto mt-3 max-w-xl text-neutral-600">{dict.signage.ctaBody}</p>
      <a
        href={pathFor('contact', locale)}
        class="btn-sweep mt-6 inline-block bg-ink px-6 py-3 text-sm font-semibold text-white transition hover:bg-neutral-800"
      >
        {dict.common.requestSurvey}
      </a>
      <p class="mt-6 text-sm text-neutral-500">
        <a href={signagePath} class="underline underline-offset-2 transition hover:text-ink">
          <ProductName />
        </a>
      </p>
    </div>
  </section>

  <JsonLd data={faqSchema(sector.faq)} />
</BaseLayout>
