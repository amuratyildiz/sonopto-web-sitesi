---
import BaseLayout from './BaseLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import ProjectFactsTable from '../components/sections/ProjectFactsTable.astro';
import FaqAccordion from '../components/sections/FaqAccordion.astro';
import { articleSchema, faqSchema } from '../lib/seo/schema';
import { absoluteUrl } from '../lib/seo/meta';
import { pathFor, type Locale } from '../lib/i18n/routes';
import { getDictionary } from '../content/i18n';
import type { Project } from '../lib/dataverse/types';

interface Props {
  project: Project;
  path: string;
  locale: Locale;
  alternatePath?: string;
}

const { project, path, locale, alternatePath } = Astro.props;
const dict = getDictionary(locale);
const title = locale === 'en' && project.titleEn ? project.titleEn : project.title;
const body = locale === 'en' && project.bodyEn ? project.bodyEn : project.bodyTr;
const description =
  (locale === 'en' ? project.metaDescriptionEn : project.metaDescriptionTr) ?? title;

// The English questions are optional in Dataverse and mostly unwritten, so an
// English page still shows the Turkish ones rather than losing the section.
const faq = locale === 'en' && project.faqEn.length > 0 ? project.faqEn : project.faq;

// FAQPage markup claims the answers are in the page's language, so it is only
// emitted when that is actually true.
const faqMatchesLocale = locale === 'tr' || project.faqEn.length > 0;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  locale={locale}
  alternatePath={alternatePath}
  image={project.coverImage}
  type="article"
>
  <article class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumbs
      items={[
        { name: dict.nav.home, path: pathFor('home', locale) },
        { name: dict.nav.references, path: pathFor('references', locale) },
        { name: title, path },
      ]}
    />

    <h1 class="mt-4 text-3xl font-bold text-ink">{title}</h1>

    <dl class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm text-neutral-500">
      {project.client && (
        <div><dt class="inline font-medium">{dict.common.client}: </dt><dd class="inline">{project.client}</dd></div>
      )}
      {project.location && (
        <div><dt class="inline font-medium">{dict.common.location}: </dt><dd class="inline">{project.location}</dd></div>
      )}
      <div>
        <dt class="inline font-medium">{dict.common.date}: </dt>
        <dd class="inline">{new Date(project.publishDate).toLocaleDateString(locale === 'tr' ? 'tr-TR' : 'en-US')}</dd>
      </div>
    </dl>

    <a href={project.coverImage} data-lightbox class="mt-6 block">
      <img
        src={project.coverImage}
        alt={project.coverAlt || title}
        width="1200"
        height="800"
        class="aspect-[3/2] w-full rounded-photo object-cover"
      />
    </a>

    <div class="prose mt-8 max-w-none" set:html={body} />

    {project.gallery.length > 0 && (
      <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3">
        {project.gallery.map((image, index) => (
          <a
            href={image.src}
            data-lightbox
            class="block"
            aria-label={image.alt || `${dict.references.gallery.photo} ${index + 2}`}
          >
            <img src={image.src} alt={image.alt} loading="lazy" width="400" height="300" class="aspect-[4/3] w-full rounded-photo object-cover" />
          </a>
        ))}
      </div>
    )}

    {project.facts.length > 0 && (
      <div class="mt-8">
        <ProjectFactsTable facts={project.facts} />
      </div>
    )}

    {faq.length > 0 && (
      <div class="mt-10">
        <h2 class="text-xl text-ink">{dict.faq.pageTitle}</h2>
        <div class="mt-4">
          <FaqAccordion items={faq} />
        </div>
      </div>
    )}

    <a href={pathFor('references', locale)} class="mt-10 inline-block text-sm font-medium text-neutral-600 transition hover:text-ink">
      &larr; {dict.common.backToReferences}
    </a>
  </article>

  {/*
    The lightbox chrome. scripts/build-search-index.mjs strips <dialog> out of
    <main> for exactly this reason — without that, "kapat", "önceki" and
    "sonraki" would join every reference page's search entry.

    Every photo above is already a link to its own file; this is the
    enhancement. With the script blocked the dialog never opens and the links
    still work.
  */}
  <dialog
    id="lightbox"
    class="lightbox"
    aria-label={dict.references.gallery.label}
    data-counter-label={dict.references.gallery.counter}
  >
    <div id="lightbox-frame" class="lightbox-frame">
      <img id="lightbox-image" class="lightbox-img" alt="" />
      <p id="lightbox-caption" class="lightbox-caption"></p>
      {/* role="status" is implicitly a polite live region, so stepping through
          the frames is announced; the same idiom as #search-status. */}
      <span id="lightbox-counter" class="lightbox-counter" role="status"></span>

      <button id="lightbox-close" type="button" class="lightbox-btn lightbox-close" aria-label={dict.references.gallery.close}>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
      <button id="lightbox-prev" type="button" class="lightbox-btn lightbox-prev" aria-label={dict.references.gallery.prev}>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
          <path d="M15 6l-6 6 6 6" />
        </svg>
      </button>
      <button id="lightbox-next" type="button" class="lightbox-btn lightbox-next" aria-label={dict.references.gallery.next}>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
          <path d="M9 6l6 6-6 6" />
        </svg>
      </button>
    </div>
  </dialog>

  <JsonLd data={articleSchema(project, absoluteUrl(path), locale)} />
  {faq.length > 0 && faqMatchesLocale && <JsonLd data={faqSchema(faq)} />}
</BaseLayout>

<script is:inline src="/lightbox.js" defer></script>
