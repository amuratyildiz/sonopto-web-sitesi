---
import BaseLayout from './BaseLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import ProjectFactsTable from '../components/sections/ProjectFactsTable.astro';
import FaqAccordion from '../components/sections/FaqAccordion.astro';
import { articleSchema } from '../lib/seo/schema';
import { absoluteUrl } from '../lib/seo/meta';
import { pathFor, type Locale } from '../lib/i18n/routes';
import { getDictionary } from '../content/i18n';
import type { Project } from '../lib/graph/types';

interface Props {
  project: Project;
  path: string;
  locale: Locale;
  alternatePath?: string;
}

const { project, path, locale, alternatePath } = Astro.props;
const dict = getDictionary(locale);
const title = locale === 'en' && project.titleEn ? project.titleEn : project.title;
const body = locale === 'en' && project.bodyEn ? project.bodyEn : project.bodyTr;
const description =
  (locale === 'en' ? project.metaDescriptionEn : project.metaDescriptionTr) ?? title;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  locale={locale}
  alternatePath={alternatePath}
  image={project.coverImage}
  type="article"
>
  <article class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumbs
      items={[
        { name: dict.nav.home, path: pathFor('home', locale) },
        { name: dict.nav.references, path: pathFor('references', locale) },
        { name: title, path },
      ]}
    />

    <h1 class="mt-4 text-3xl font-bold text-ink">{title}</h1>

    <dl class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm text-neutral-500">
      {project.client && (
        <div><dt class="inline font-medium">{dict.common.client}: </dt><dd class="inline">{project.client}</dd></div>
      )}
      {project.location && (
        <div><dt class="inline font-medium">{dict.common.location}: </dt><dd class="inline">{project.location}</dd></div>
      )}
      <div>
        <dt class="inline font-medium">{dict.common.date}: </dt>
        <dd class="inline">{new Date(project.publishDate).toLocaleDateString(locale === 'tr' ? 'tr-TR' : 'en-US')}</dd>
      </div>
    </dl>

    <img
      src={project.coverImage}
      alt={title}
      width="1200"
      height="800"
      class="mt-6 aspect-[3/2] w-full rounded-photo object-cover"
    />

    <div class="prose prose-brand mt-8 max-w-none" set:html={body} />

    {project.gallery.length > 0 && (
      <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3">
        {project.gallery.map((image) => (
          <img src={image} alt="" loading="lazy" width="400" height="300" class="aspect-[4/3] w-full rounded-photo object-cover" />
        ))}
      </div>
    )}

    {project.facts.length > 0 && (
      <div class="mt-8">
        <ProjectFactsTable facts={project.facts} />
      </div>
    )}

    {project.faq.length > 0 && (
      <div class="mt-10">
        <h2 class="text-xl text-ink">{dict.faq.pageTitle}</h2>
        <div class="mt-4">
          <FaqAccordion items={project.faq} />
        </div>
      </div>
    )}

    <a href={pathFor('references', locale)} class="mt-10 inline-block text-sm font-medium text-neutral-600 hover:text-ink">
      &larr; {dict.common.backToReferences}
    </a>
  </article>

  <JsonLd data={articleSchema(project, absoluteUrl(path))} />
</BaseLayout>
