---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import { getDictionary } from '../content/i18n';
import { pathFor } from '../lib/i18n/routes';

const locale = 'tr' as const;
const dict = getDictionary(locale);
const path = pathFor('visionMission', locale);
---

<BaseLayout title={dict.visionMission.pageTitle} description={dict.visionMission.vision} path={path} locale={locale} alternatePath={pathFor('visionMission', 'en')}>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ name: dict.nav.home, path: pathFor('home', locale) }, { name: dict.nav.visionMission, path }]} />
    <h1 class="mt-4 text-3xl font-bold text-ink">{dict.visionMission.pageTitle}</h1>

    <div class="mt-8 grid gap-8 sm:grid-cols-2">
      <div class="border border-neutral-100 bg-white p-6">
        <h2 class="text-lg text-ink">{dict.visionMission.visionTitle}</h2>
        <p class="mt-3 text-neutral-600">{dict.visionMission.vision}</p>
      </div>
      <div class="border border-neutral-100 bg-white p-6">
        <h2 class="text-lg text-ink">{dict.visionMission.missionTitle}</h2>
        <p class="mt-3 text-neutral-600">{dict.visionMission.mission}</p>
      </div>
    </div>
  </div>
</BaseLayout>
