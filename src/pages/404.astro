---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDictionary } from '../content/i18n';
import { pathFor } from '../lib/i18n/routes';

const locale = 'tr' as const;
const dict = getDictionary(locale);
---

<BaseLayout title="Sayfa Bulunamadı" description="Aradığınız sayfa bulunamadı." path="/404/" locale={locale}>
  <div class="mx-auto max-w-xl px-4 py-24 text-center sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-wide text-neutral-500">404</p>
    <h1 class="mt-2 text-3xl font-bold text-ink">Sayfa Bulunamadı</h1>
    <p class="mt-3 text-neutral-600">Aradığınız sayfa taşınmış veya kaldırılmış olabilir.</p>
    <a href={pathFor('home', locale)} class="btn-sweep mt-8 inline-block bg-ink px-6 py-3 text-sm font-semibold text-white transition hover:bg-neutral-800">
      {dict.nav.home}
    </a>
  </div>
</BaseLayout>
