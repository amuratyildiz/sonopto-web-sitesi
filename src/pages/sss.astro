---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import FaqAccordion from '../components/sections/FaqAccordion.astro';
import { getDictionary } from '../content/i18n';
import { pathFor } from '../lib/i18n/routes';
import JsonLd from '../components/seo/JsonLd.astro';
import { faqSchema } from '../lib/seo/schema';

const locale = 'tr' as const;
const dict = getDictionary(locale);
const path = pathFor('faq', locale);
---

<BaseLayout title={dict.faq.pageTitle} description={dict.faq.pageIntro} path={path} locale={locale} alternatePath={pathFor('faq', 'en')}>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ name: dict.nav.home, path: pathFor('home', locale) }, { name: dict.nav.faq, path }]} />
    <h1 class="mt-4 text-3xl font-bold text-ink">{dict.faq.pageTitle}</h1>
    <p class="mt-3 text-neutral-600">{dict.faq.pageIntro}</p>

    <div data-reveal class="mt-8">
      <FaqAccordion items={[...dict.faq.items]} />
    </div>

    <p class="mt-8 text-sm text-neutral-500">
      Ürünün kullanımıyla ilgili bir sorunuz varsa <a href={pathFor('support', locale)} class="font-medium text-neutral-700 underline">Bilgi Bankası</a>'na
      bakın. Aradığınızı bulamadıysanız <a href={pathFor('contact', locale)} class="font-medium text-neutral-700 underline">bize ulaşın</a>.
    </p>
  </div>

  <JsonLd data={faqSchema([...dict.faq.items])} />
</BaseLayout>
