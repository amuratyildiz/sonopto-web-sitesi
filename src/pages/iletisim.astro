---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import { getDictionary } from '../content/i18n';
import { pathFor } from '../lib/i18n/routes';
import { company } from '../data/company';

const locale = 'tr' as const;
const dict = getDictionary(locale);
const path = pathFor('contact', locale);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<BaseLayout title={dict.contact.pageTitle} description={dict.contact.pageIntro} path={path} locale={locale} alternatePath={pathFor('contact', 'en')}>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ name: dict.nav.home, path: pathFor('home', locale) }, { name: dict.nav.contact, path }]} />
    <h1 class="mt-4 text-3xl font-bold text-ink">{dict.contact.pageTitle}</h1>
    <p class="mt-3 max-w-xl text-neutral-600">{dict.contact.pageIntro}</p>

    <div class="mt-10 grid gap-10 lg:grid-cols-5">
      <div class="lg:col-span-2 space-y-6">
        <div>
          <h2 class="text-sm uppercase tracking-wide text-neutral-500">{dict.contact.addressTitle}</h2>
          <p class="mt-1 text-neutral-800">
            {company.address.street}<br />
            {company.address.district}/{company.address.city}
          </p>
        </div>
        <div>
          <h2 class="text-sm uppercase tracking-wide text-neutral-500">{dict.contact.phoneTitle}</h2>
          <a href={`tel:${company.phone.replace(/\s+/g, '')}`} class="mt-1 block text-neutral-800 transition hover:text-ink">{company.phone}</a>
        </div>
        <div>
          <h2 class="text-sm uppercase tracking-wide text-neutral-500">{dict.contact.emailTitle}</h2>
          <a href={`mailto:${company.email}`} class="mt-1 block text-neutral-800 transition hover:text-ink">{company.email}</a>
        </div>

        <img
          src="/iletisim/teknik-destek-hatti-sonopto.webp"
          alt={dict.contact.imageAlt}
          width="1600"
          height="835"
          loading="lazy"
          class="aspect-[16/9] w-full rounded-photo object-cover"
        />
      </div>

      <form
        id="contact-form"
        method="post"
        class="lg:col-span-3 space-y-4 border border-neutral-100 bg-white p-6"
        data-success-message={dict.contact.formSuccess}
        data-error-message={dict.contact.formError}
      >
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block text-sm font-medium text-neutral-800">
            {dict.contact.formName} <span class="text-neutral-400">({dict.contact.formRequired})</span>
            <input type="text" name="name" required class="mt-1 w-full border border-neutral-200 px-3 py-2 text-sm focus:border-neutral-500 focus:outline-none" />
          </label>
          <label class="block text-sm font-medium text-neutral-800">
            {dict.contact.formPhone}
            <input type="tel" name="phone" class="mt-1 w-full border border-neutral-200 px-3 py-2 text-sm focus:border-neutral-500 focus:outline-none" />
          </label>
          <label class="block text-sm font-medium text-neutral-800">
            {dict.contact.formEmail} <span class="text-neutral-400">({dict.contact.formRequired})</span>
            <input type="email" name="email" required class="mt-1 w-full border border-neutral-200 px-3 py-2 text-sm focus:border-neutral-500 focus:outline-none" />
          </label>
          <label class="block text-sm font-medium text-neutral-800">
            {dict.contact.formCompany}
            <input type="text" name="company" class="mt-1 w-full border border-neutral-200 px-3 py-2 text-sm focus:border-neutral-500 focus:outline-none" />
          </label>
        </div>

        <label class="block text-sm font-medium text-neutral-800">
          {dict.contact.formSubject} <span class="text-neutral-400">({dict.contact.formRequired})</span>
          <input type="text" name="subject" required class="mt-1 w-full border border-neutral-200 px-3 py-2 text-sm focus:border-neutral-500 focus:outline-none" />
        </label>

        <label class="block text-sm font-medium text-neutral-800">
          {dict.contact.formMessage} <span class="text-neutral-400">({dict.contact.formRequired})</span>
          <textarea name="message" required rows="5" class="mt-1 w-full border border-neutral-200 px-3 py-2 text-sm focus:border-neutral-500 focus:outline-none"></textarea>
        </label>

        <!-- Honeypot: hidden from real users, left blank by them; bots tend to fill every field. -->
        <div class="hidden" aria-hidden="true">
          <label>
            Web sitesi
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}

        <button
          type="submit"
          class="btn-sweep w-full bg-ink px-6 py-3 text-sm font-semibold text-white transition hover:bg-neutral-800 disabled:cursor-not-allowed disabled:opacity-60"
        >
          {dict.common.sendMessage}
        </button>

        <p id="contact-form-status" role="status" class="hidden text-sm"></p>
      </form>
    </div>
  </div>
</BaseLayout>

{turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script is:inline src="/contact-form.js" defer></script>
