---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import ServiceCard from '../../components/sections/ServiceCard.astro';
import { getDictionary } from '../../content/i18n';
import { pathFor } from '../../lib/i18n/routes';
import { serviceEntries, serviceKeys } from '../../data/services';

const locale = 'tr' as const;
const dict = getDictionary(locale);

const services = serviceKeys.map((key) => ({
  ...dict.services.items[key],
  path: pathFor(serviceEntries[key].routeId, locale),
  icon: serviceEntries[key].icon,
}));
---

<BaseLayout
  title={dict.services.pageTitle}
  description={dict.services.pageIntro}
  path={pathFor('services', locale)}
  locale={locale}
  alternatePath={pathFor('services', 'en')}
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ name: dict.nav.home, path: pathFor('home', locale) }, { name: dict.nav.services, path: pathFor('services', locale) }]} />
    <h1 class="mt-4 text-3xl font-bold text-ink">{dict.services.pageTitle}</h1>
    <p class="mt-3 max-w-2xl text-neutral-600">{dict.services.pageIntro}</p>

    <div data-reveal-group class="mt-10 grid gap-6 sm:grid-cols-2">
      {services.map((service, i) => (
        <ServiceCard
          title={service.title}
          summary={service.summary}
          href={service.path}
          readMoreLabel={dict.common.readMore}
          icon={service.icon}
          index={i + 1}
        />
      ))}
    </div>
  </div>
</BaseLayout>
