---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import { getDictionary } from '../../content/i18n';
import { pathFor } from '../../lib/i18n/routes';

const locale = 'tr' as const;
const dict = getDictionary(locale);
const service = dict.services.items.installation;
const path = pathFor('servicesInstallation', locale);
---

<BaseLayout title={service.title} description={service.summary} path={path} locale={locale} alternatePath={pathFor('servicesInstallation', 'en')}>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumbs
      items={[
        { name: dict.nav.home, path: pathFor('home', locale) },
        { name: dict.nav.services, path: pathFor('services', locale) },
        { name: service.title, path },
      ]}
    />
    <h1 class="mt-4 text-3xl font-bold text-ink">{service.title}</h1>
    <p class="mt-3 text-neutral-600">{service.summary}</p>

    <ul class="mt-8 space-y-3">
      {service.details.map((item) => (
        <li class="flex gap-3 text-neutral-800">
          <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-neutral-500"></span>
          {item}
        </li>
      ))}
    </ul>

    <a
      href={pathFor('contact', locale)}
      class="mt-10 inline-block bg-ink px-6 py-3 text-sm font-semibold text-white transition hover:bg-neutral-800"
    >
      {dict.common.getQuote}
    </a>
  </div>
</BaseLayout>
