---
import KbArticleLayout from '../../../layouts/KbArticleLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { kbCategoryEntries } from '../../../data/kb';
import { kbArticlePath } from '../../../lib/kb/paths';

// The existence of a Turkish file is the translation gate, so there is nothing
// to filter here — the same rule the references pages express with
// `.filter(p => p.bodyEn)`, made structural.
export async function getStaticPaths() {
  const entries = await getCollection('kbTr', (e) => !e.data.draft);
  return entries.map((entry) => ({
    params: { category: kbCategoryEntries[entry.data.category].slug.tr, slug: entry.data.urlSlug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
// hreflang only when the English original is still there to point at.
const alt = await getEntry('kbEn', entry.id);
---

<KbArticleLayout
  entry={entry}
  locale="tr"
  alternatePath={alt ? kbArticlePath(alt, 'en') : undefined}
/>
