---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/seo/Breadcrumbs.astro';
import SolutionCard from '../../../components/sections/SolutionCard.astro';
import { getDictionary } from '../../../content/i18n';
import { pathFor } from '../../../lib/i18n/routes';
import { solutionEntries, solutionKeys } from '../../../data/solutions';

const locale = 'en' as const;
const dict = getDictionary(locale);
const path = pathFor('solutions', locale);

const solutions = solutionKeys.map((key) => ({
  ...dict.solutions.items[key],
  path: pathFor(solutionEntries[key].routeId, locale),
  image: solutionEntries[key].image,
}));
---

<BaseLayout
  title={dict.solutions.pageTitle}
  description={dict.solutions.pageIntro}
  path={path}
  locale={locale}
  alternatePath={pathFor('solutions', 'tr')}
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ name: dict.nav.home, path: pathFor('home', locale) }, { name: dict.nav.solutions, path }]} />
    <h1 class="mt-4 text-3xl font-bold text-ink">{dict.solutions.headline}</h1>
    <p class="mt-3 max-w-2xl text-neutral-600">{dict.solutions.pageIntro}</p>

    <div data-reveal-group class="mt-10 grid gap-6 sm:grid-cols-2">
      {solutions.map((solution) => (
        <SolutionCard
          title={solution.title}
          summary={solution.summary}
          href={solution.path}
          image={solution.image}
          imageAlt={solution.imageAlt}
          readMoreLabel={dict.common.readMore}
        />
      ))}
    </div>
  </div>
</BaseLayout>
