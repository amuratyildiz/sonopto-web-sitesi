---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import { getDictionary } from '../../content/i18n';
import { pathFor } from '../../lib/i18n/routes';

const locale = 'en' as const;
const dict = getDictionary(locale);
const path = pathFor('visionMission', locale);
---

<BaseLayout title={dict.visionMission.pageTitle} description={dict.visionMission.vision} path={path} locale={locale} alternatePath={pathFor('visionMission', 'tr')}>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ name: dict.nav.home, path: pathFor('home', locale) }, { name: dict.nav.visionMission, path }]} />
    <h1 class="mt-4 text-3xl font-bold text-ink">{dict.visionMission.pageTitle}</h1>

    <div data-reveal-group class="mt-8 grid gap-8 sm:grid-cols-2">
      <div data-reveal class="border border-neutral-100 bg-white p-6">
        <h2 class="text-lg text-ink">{dict.visionMission.visionTitle}</h2>
        <p class="mt-3 font-heading text-xl text-ink">{dict.visionMission.vision}</p>
        <p class="mt-3 text-neutral-600">{dict.visionMission.visionDetail}</p>
      </div>
      <div data-reveal class="border border-neutral-100 bg-white p-6">
        <h2 class="text-lg text-ink">{dict.visionMission.missionTitle}</h2>
        <p class="mt-3 font-heading text-xl text-ink">{dict.visionMission.mission}</p>
        <p class="mt-3 text-neutral-600">{dict.visionMission.missionDetail}</p>
      </div>
    </div>

    <h2 class="mt-12 text-lg text-ink">{dict.visionMission.valuesTitle}</h2>
    <div data-reveal-group class="mt-6 grid gap-6 sm:grid-cols-3">
      {dict.visionMission.values.map((value) => (
        <div data-reveal class="border border-neutral-100 bg-white p-6">
          <h3 class="text-ink">{value.title}</h3>
          <p class="mt-2 text-sm text-neutral-600">{value.description}</p>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
