---
import type { Project } from '../../lib/graph/types';

interface Props {
  project: Project;
  href: string;
  readMoreLabel: string;
}

const { project, href, readMoreLabel } = Astro.props;
---

<a href={href} data-reveal class="card-status group flex flex-col overflow-hidden border border-neutral-100 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
  <img
    src={project.coverImage}
    alt={project.title}
    width="600"
    height="400"
    loading="lazy"
    class="aspect-[3/2] w-full object-cover"
  />
  <div class="flex flex-1 flex-col p-5">
    {project.categories[0] && (
      <span class="text-xs font-semibold uppercase tracking-wide text-neutral-500">{project.categories[0]}</span>
    )}
    <h3 class="mt-1 text-base text-ink">{project.title}</h3>
    <span class="mt-3 text-sm font-medium text-neutral-500 transition group-hover:text-neutral-700">{readMoreLabel} &rarr;</span>
  </div>
</a>
