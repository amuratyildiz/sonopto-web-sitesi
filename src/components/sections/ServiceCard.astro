---
interface Props {
  title: string;
  summary: string;
  href: string;
  readMoreLabel: string;
}

const { title, summary, href, readMoreLabel } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col border border-neutral-100 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
>
  <h3 class="text-lg text-ink">{title}</h3>
  <p class="mt-2 flex-1 text-sm text-neutral-600">{summary}</p>
  <span class="mt-4 text-sm font-medium text-neutral-500 group-hover:text-neutral-700">
    {readMoreLabel} &rarr;
  </span>
</a>
