---
import ServiceIcon from './ServiceIcon.astro';
import type { ServiceIconName } from '../../data/services';

interface Props {
  title: string;
  summary: string;
  href: string;
  readMoreLabel: string;
  icon: ServiceIconName;
  /** 1-based grid position, rendered as the 01–04 corner label. */
  index: number;
}

const { title, summary, href, readMoreLabel, icon, index } = Astro.props;
const indexLabel = String(index).padStart(2, '0');
---

{/*
  Utilities here cover layout and static typography only. Everything the
  stylesheet drives — padding, background, border, shadow, transition,
  translate, the read-more colour — is deliberately absent: utilities sit in a
  later cascade layer than `components`, so a utility would beat .service-card
  in every state at any specificity.
*/}
<a href={href} data-reveal class="service-card card-status flex flex-col">
  <span class="svc-index" aria-hidden="true">{indexLabel}</span>
  <ServiceIcon name={icon} />
  <h3 class="mt-5 text-lg text-white">{title}</h3>
  <p class="mt-2 flex-1 text-sm text-neutral-300">{summary}</p>
  <span class="svc-more mt-5 text-sm font-medium">
    {readMoreLabel} <span class="svc-arrow" aria-hidden="true">&rarr;</span>
  </span>
</a>
