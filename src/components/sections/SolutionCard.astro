---
interface Props {
  title: string;
  summary: string;
  href: string;
  image: string;
  imageAlt: string;
  readMoreLabel: string;
}

const { title, summary, href, image, imageAlt, readMoreLabel } = Astro.props;
---

<a
  href={href}
  data-reveal
  class="card-status group flex flex-col overflow-hidden border border-neutral-100 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
>
  <img src={image} alt={imageAlt} width="800" height="418" loading="lazy" class="aspect-[16/9] w-full object-cover" />
  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-base text-ink">{title}</h3>
    <p class="mt-2 flex-1 text-sm text-neutral-600">{summary}</p>
    <span class="mt-4 text-sm font-medium text-neutral-500 transition group-hover:text-neutral-700">
      {readMoreLabel} &rarr;
    </span>
  </div>
</a>
