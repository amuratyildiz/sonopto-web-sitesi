---
import { getClients } from '../../lib/dataverse/clients';
import { pathFor, type Locale } from '../../lib/i18n/routes';

interface Props {
  title: string;
  locale: Locale;
}

const { title, locale } = Astro.props;
const clients = await getClients();

/**
 * A copy of PartnerLogos rather than a shared component.
 *
 * That strip is built for the brands we resell: white wordmarks on a black
 * band, in a wide h-8 w-28 box (see src/data/partners.ts). Institutional
 * logos are colourful and mostly squarish, and they disappear on black — so
 * this one is a light band with a taller box. The homepage also already runs
 * white → black → white → grey, and a second black band would stack.
 */
const reference = pathFor('references', locale);
---

{clients.length > 0 && (
  <section class="border-t border-neutral-200">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <h2 class="text-center font-mono text-xs uppercase tracking-widest text-neutral-500">{title}</h2>
      <div data-reveal class="mt-8 flex flex-wrap items-center justify-center gap-x-10 gap-y-8">
        {clients.map((client) => {
          const slug = locale === 'en' ? (client.slugEn ?? client.slug) : client.slug;
          const logo = (
            <img
              src={client.logo}
              alt={client.name}
              width="128"
              height="48"
              loading="lazy"
              class="h-12 w-32 object-contain opacity-70 grayscale transition hover:opacity-100 hover:grayscale-0"
            />
          );
          return slug ? (
            <a href={`${reference}${slug}/`} class="client-logo-link">{logo}</a>
          ) : (
            logo
          );
        })}
      </div>
    </div>
  </section>
)}
