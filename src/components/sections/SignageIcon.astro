---
import type { SignageIconName } from '../../data/signage';

interface Props {
  name: SignageIconName;
}

const { name } = Astro.props;

/*
 * Official product marks for the integrations we genuinely connect to, used to
 * identify those products and nothing else — no partnership or endorsement is
 * implied anywhere on the page. Path data and the brand hex are taken verbatim
 * from simple-icons 16.32.0; they are not redrawn, recoloured or restyled,
 * because a modified mark is the one thing every brand guideline forbids.
 *
 * Canva publishes no redistributable vector (it is carried by neither
 * simple-icons nor the gilbarbara set, both having dropped it at the company's
 * request), so it ships as a raster instead — see RASTER_MARKS. Drawing an
 * approximation was never an option: that is the altered mark described above.
 */
const BRAND_MARKS = {
  drive: {
    color: '#4285F4',
    path: 'M12.01 1.485c-2.082 0-3.754.02-3.743.047.01.02 1.708 3.001 3.774 6.62l3.76 6.574h3.76c2.081 0 3.753-.02 3.742-.047-.005-.02-1.708-3.001-3.775-6.62l-3.76-6.574zm-4.76 1.73a789.828 789.861 0 0 0-3.63 6.319L0 15.868l1.89 3.298 1.885 3.297 3.62-6.335 3.618-6.33-1.88-3.287C8.1 4.704 7.255 3.22 7.25 3.214zm2.259 12.653-.203.348c-.114.198-.96 1.672-1.88 3.287a423.93 423.948 0 0 1-1.698 2.97c-.01.026 3.24.042 7.222.042h7.244l1.796-3.157c.992-1.734 1.85-3.23 1.906-3.323l.104-.167h-7.249z',
  },
  sheets: {
    color: '#34A853',
    path: 'M11.318 12.545H7.91v-1.909h3.41v1.91zM14.728 0v6h6l-6-6zm1.363 10.636h-3.41v1.91h3.41v-1.91zm0 3.273h-3.41v1.91h3.41v-1.91zM20.727 6.5v15.864c0 .904-.732 1.636-1.636 1.636H4.909a1.636 1.636 0 0 1-1.636-1.636V1.636C3.273.732 4.005 0 4.909 0h9.318v6.5h6.5zm-3.273 2.773H6.545v7.909h10.91v-7.91zm-6.136 4.636H7.91v1.91h3.41v-1.91z',
  },
} as const;

/*
 * Marks that exist only as bitmaps. Both were supplied as JPEGs on a pure white
 * field and re-encoded to lossless WebP at 128px — three times the 2.5rem they
 * render at, so they stay crisp on a high-DPI screen. The white field is left
 * in rather than keyed out: these sit on white cards, so it is invisible, and
 * keying a lossy source would leave a halo on the gradient edges.
 *
 * Decorative: the heading beside each one already names the product, so an alt
 * text here would only make a screen reader say it twice.
 */
const RASTER_MARKS = {
  design: '/signage/canva-logo.webp',
  doorSign: '/signage/kapi-etiketi-ikonu.webp',
} as const;

const brand = BRAND_MARKS[name as keyof typeof BRAND_MARKS];
const raster = RASTER_MARKS[name as keyof typeof RASTER_MARKS];
---

{
  raster ? (
    <img class="sig-icon" src={raster} alt="" width="128" height="128" loading="lazy" decoding="async" />
  ) : brand ? (
    /* The mark keeps its own 24-unit viewBox and its own fill; it is not forced
       into the line-icon grid, which would distort it. */
    <svg class="sig-icon" viewBox="0 0 24 24" fill={brand.color} aria-hidden="true">
      <path d={brand.path} />
    </svg>
  ) : (
    /*
      House icons, in the same technical register as ServiceIcon: 48-unit
      viewBox, square caps, integer coordinates so the even stroke lands on
      whole device pixels, currentColor so the card owns the tone.

      Feature icons move on hover, driven from .sig-* in global.css. Every rest
      state is a complete picture on its own, because touch devices never reach
      the hover state. Integration icons stay still — they identify a product
      rather than illustrate a behaviour.
    */
    <svg
      class="sig-icon"
      viewBox="0 0 48 48"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="square"
      aria-hidden="true"
    >
      {name === 'offline' && (
        <>
          {/* Media descending into local storage — the reason playback survives
              a dropped connection. */}
          <g class="sig-drop">
            <line x1="24" y1="8" x2="24" y2="29" />
            <polyline points="15,20 24,29 33,20" />
          </g>
          <polyline points="10,31 10,40 38,40 38,31" />
        </>
      )}

      {name === 'grouping' && (
        <>
          {/* Three screens settling onto one bus, left to right. A row, not the
              2x2 grid the installation icon already uses. */}
          <rect class="sig-screen sig-screen-1" x="4" y="8" width="12" height="10" />
          <rect class="sig-screen sig-screen-2" x="18" y="8" width="12" height="10" />
          <rect class="sig-screen sig-screen-3" x="32" y="8" width="12" height="10" />
          <line x1="10" y1="18" x2="10" y2="26" />
          <line x1="24" y1="18" x2="24" y2="26" />
          <line x1="38" y1="18" x2="38" y2="26" />
          <line x1="10" y1="26" x2="38" y2="26" />
          <line x1="24" y1="26" x2="24" y2="34" />
          <rect x="18" y="34" width="12" height="8" />
        </>
      )}

      {name === 'power' && (
        <>
          {/* Standard power mark: the gap sits at the top, so the arc runs the
              long way round and the bar closes it. The bar rises on hover like
              a switch being thrown. */}
          <path d="M32,14.5 A14,14 0 1,1 16,14.5" />
          <line class="sig-power-bar" x1="24" y1="8" x2="24" y2="24" />
        </>
      )}

      {name === 'geo' && (
        <g class="sig-pin">
          {/* Pin built from a true semicircle plus two straight flanks — no
              hand-drawn bezier, which never sits right at this stroke weight. */}
          <path d="M14,20 A10,10 0 0,1 34,20" />
          <line x1="14" y1="20" x2="24" y2="40" />
          <line x1="34" y1="20" x2="24" y2="40" />
          <circle cx="24" cy="20" r="4" />
        </g>
      )}

      {name === 'monitoring' && (
        <>
          {/* At rest the trace is flat; on hover the screen starts reporting.
              Both lines occupy the same band so the swap reads as one line
              coming alive rather than two shapes crossfading. */}
          <rect x="6" y="10" width="36" height="24" />
          <line x1="24" y1="34" x2="24" y2="40" />
          <line x1="16" y1="40" x2="32" y2="40" />
          <line class="sig-flat" x1="12" y1="23" x2="36" y2="23" />
          <polyline class="sig-pulse" points="12,23 18,23 21,16 27,28 30,21 36,21" />
        </>
      )}

      {name === 'retail' && (
        <>
          {/* Shopfront: awning over a glazed front with a doorway. */}
          <polygon points="6,16 10,8 38,8 42,16" />
          <rect x="8" y="16" width="32" height="26" />
          <rect x="20" y="30" width="8" height="12" />
        </>
      )}

      {name === 'food' && (
        <>
          {/* A menu board, not cutlery: the plate sits on the screen, which is
              what this sector actually buys. */}
          <rect x="6" y="8" width="36" height="28" />
          <circle cx="24" cy="22" r="6" />
          <line x1="14" y1="16" x2="14" y2="28" />
          <line x1="34" y1="16" x2="34" y2="28" />
          <line x1="24" y1="36" x2="24" y2="42" />
        </>
      )}

      {name === 'office' && (
        <>
          {/* Office block: two bays, four floors, entrance at grade. */}
          <rect x="10" y="8" width="28" height="34" />
          <line x1="24" y1="8" x2="24" y2="34" />
          <line x1="10" y1="18" x2="38" y2="18" />
          <line x1="10" y1="28" x2="38" y2="28" />
          <rect x="20" y="34" width="8" height="8" />
        </>
      )}

      {name === 'health' && (
        /* Drawn as one outline rather than two crossed bars, so the stroke does
           not double up where they would overlap. */
        <polygon points="20,8 28,8 28,20 40,20 40,28 28,28 28,40 20,40 20,28 8,28 8,20 20,20" />
      )}

      {name === 'scheduling' && (
        <>
          {/* Hands are separate elements so only the minute hand sweeps. */}
          <circle cx="24" cy="24" r="15" />
          <line class="sig-hand-hour" x1="24" y1="14" x2="24" y2="24" />
          <line class="sig-hand-min" x1="24" y1="24" x2="32" y2="24" />
        </>
      )}

    </svg>
  )
}
