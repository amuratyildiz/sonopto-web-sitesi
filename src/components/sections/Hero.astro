---
interface Props {
  title: string;
  subtitle: string;
  backgroundImage: string;
  backgroundImageAlt: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const { title, subtitle, backgroundImage, backgroundImageAlt, ctaLabel, ctaHref } = Astro.props;
---

<section class="hero-frame flex min-h-svh items-center bg-ink text-white">
  <img
    src={backgroundImage}
    alt={backgroundImageAlt}
    width="2400"
    height="1253"
    loading="eager"
    fetchpriority="high"
    class="hero-photo"
  />
  <div class="hero-photo-scrim"></div>

  <div class="mx-auto w-full max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-28">
    <h1 class="hero-in hero-in-1 text-3xl tracking-tight text-balance sm:text-5xl">{title}</h1>
    <p class="hero-in hero-in-2 mx-auto mt-6 max-w-2xl text-lg text-neutral-200 text-balance">{subtitle}</p>
    {ctaLabel && ctaHref && (
      <a
        href={ctaHref}
        class="btn-sweep hero-in hero-in-3 mt-8 inline-block bg-accent px-6 py-3 text-sm font-semibold text-on-accent transition hover:bg-accent-hover"
      >
        {ctaLabel}
      </a>
    )}
  </div>

  {/* Shares the .led-flicker animation with the logo dot; both start on first
      paint with no delay, so they blink in step. */}
  <div class="pointer-events-none absolute inset-x-0 bottom-8 flex justify-center sm:bottom-10" aria-hidden="true">
    <svg
      class="led-flicker size-8 text-accent"
      width="30"
      height="30"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="square"
    >
      <path d="M6 9l6 6 6-6" />
    </svg>
  </div>
</section>
