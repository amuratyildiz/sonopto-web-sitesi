# Copy this file to .env and fill in real values once the M365 tenant side
# has been provisioned (see README). The site builds fine with these unset —
# it falls back to local sample data (src/data/projects.sample.ts).

# Dataverse — build-time read access to the reference write-ups, their credit
# rows, FAQ rows and photos, plus the homepage client logos. The service
# principal is granted READ ONLY on those five tables through a role of its
# own ("Web Sitesi Icerik Okuma"); it cannot write and cannot see the CRM.
#
# Unset, the build falls back to src/data/projects.sample.ts — three
# placeholders. That is fine locally and refused in CI, so a missing secret
# cannot quietly replace the real references on the live site.
DATAVERSE_URL=
DATAVERSE_TENANT_ID=
DATAVERSE_CLIENT_ID=
DATAVERSE_CLIENT_SECRET=

# Microsoft Graph — the "Partners" brand strip is the only thing still read
# from SharePoint. App registration needs the APPLICATION permission
# Sites.Selected, granted read-only on just the one site (see README).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SITE_ID=

# "Partners" list + "PartnerLogos" library, feeding the homepage brand strip.
# Unset, the strip falls back to src/data/partners.ts and the logo files
# committed under public/partners/.
GRAPH_PARTNERS_LIST_ID=
GRAPH_PARTNER_LOGOS_DRIVE_ID=

# Only the one-off scripts need these: scripts/provision-sharepoint-list.mjs
# and scripts/migrate-projects-to-dataverse.mjs. The site build does not.
GRAPH_PROJECTS_LIST_ID=
GRAPH_MEDIA_DRIVE_ID=

# Cloudflare Turnstile — public site key for the contact form widget.
# The widget and its script tag are skipped entirely when this is unset.
PUBLIC_TURNSTILE_SITE_KEY=
