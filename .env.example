# Copy this file to .env and fill in real values once the M365 tenant side
# has been provisioned (see README). The site builds fine with these unset —
# it falls back to local sample data (src/data/projects.sample.ts).

# Microsoft Graph — build-time read access to the "Projects" SharePoint list.
# App registration needs the APPLICATION permission Sites.Selected, granted
# read-only on just the one SharePoint site (see README).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SITE_ID=
GRAPH_PROJECTS_LIST_ID=

# Microsoft Graph — "ProjectMedia" document library, used by
# scripts/fetch-project-media.mjs (prebuild step) to download project photos.
GRAPH_MEDIA_DRIVE_ID=

# Cloudflare Turnstile — public site key for the contact form widget.
# The widget and its script tag are skipped entirely when this is unset.
PUBLIC_TURNSTILE_SITE_KEY=
